#!/usr/bin/env php
<?php

$port = 8000;

while (true) {
    $socket = @stream_socket_server("tcp://127.0.0.1:{$port}");
    if ($socket !== false) {
        fclose($socket);
        break;
    }
    $port++;
    if ($port > 65535) {
        fwrite(STDERR, "No available port found.\n");
        exit(1);
    }
}

$url = "http://localhost:{$port}";

$browse = PHP_OS_FAMILY === 'Windows'
    ? 'sleep(2); pclose(popen(' . var_export('start "" ' . $url, true) . ', "r"));'
    : 'sleep(2); exec(' . var_export(
        (PHP_OS_FAMILY === 'Darwin' ? 'open ' : 'xdg-open ') . escapeshellarg($url)
      , true) . ');';

if (PHP_OS_FAMILY === 'Windows') {
    pclose(popen(
        'start /B "" ' . escapeshellarg(PHP_BINARY) . ' -r ' . escapeshellarg($browse),
        'r'
    ));
} else {
    exec(escapeshellarg(PHP_BINARY) . ' -r ' . escapeshellarg($browse) . ' >/dev/null 2>&1 &');
}

$cmd = sprintf(
    'npx concurrently -k -c %s --names=server,queue,vite %s %s %s',
    escapeshellarg('#93c5fd,#c4b5fd,#fdba74'),
    escapeshellarg("php artisan serve --port={$port}"),
    escapeshellarg('php artisan queue:listen --tries=1'),
    escapeshellarg('bun run dev')
);

passthru($cmd, $exitCode);
exit($exitCode);
