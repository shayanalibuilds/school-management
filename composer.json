{
    "name": "shayanalibuilds/school-management-system",
    "type": "project",
    "description": "School management system built with Laravel, Livewire, Flux UI, and Filament.",
    "keywords": [
        "laravel",
        "school-management",
        "livewire",
        "filament"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0@beta",
        "nunomaduro/essentials": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "joshcirre/instruckt-laravel": "^0.4.16",
        "larastan/larastan": "^3.4",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "peckphp/peck": "^0.3.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "php ./bin/dev"
        ],
        "test:style": "pint --test",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:spell": "@php scripts/spellcheck.php",
        "test:typos": "peck",
        "test:refactor": "rector --dry-run --no-progress-bar",
        "test": [
            "@test:style",
            "@test:types",
            "@test:spell",
            "@test:typos",
            "@test:refactor",
            "@php artisan test"
        ],
        "lint": [
            "pint",
            "@php scripts/spellcheck.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": []
}
